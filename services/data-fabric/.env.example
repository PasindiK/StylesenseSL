# Data Fabric Service Configuration
PYTHONUNBUFFERED=1
SERVICE_NAME=data-fabric
SERVICE_PORT=8002
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/data_fabric_db

# API Configuration
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost

# Data Configuration
TRANSFORMATION_TIMEOUT=3600
BATCH_SIZE=1000

# Logging
LOG_LEVEL=INFO
