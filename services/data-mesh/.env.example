# Data Mesh Service Configuration
PYTHONUNBUFFERED=1
SERVICE_NAME=data-mesh
SERVICE_PORT=8001
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/data_mesh_db

# API Configuration
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost

# Data Configuration
MAX_FILE_SIZE=1000000000
ALLOWED_FORMATS=csv,json,parquet

# Logging
LOG_LEVEL=INFO
