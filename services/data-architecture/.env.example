# Data Architecture Service Configuration
PYTHONUNBUFFERED=1
SERVICE_NAME=data-architecture
SERVICE_PORT=8003
DEBUG=true

# Database
DATABASE_URL=postgresql://postgres:password@postgres:5432/data_architecture_db

# API Configuration
API_HOST=0.0.0.0
CORS_ORIGINS=http://localhost:3000,http://localhost

# Data Configuration
QUALITY_CHECK_TIMEOUT=1800
ENABLE_PROFILING=true

# Logging
LOG_LEVEL=INFO
