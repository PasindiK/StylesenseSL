# Vercel Production: copy to Project → Settings → Environment Variables, then Redeploy.
# Requires frontend/vercel.json. Update vercel.json when Azure IPs change.
#
# VITE_AGENTIC_API_URL is used for cart, chat, dashboard, FeatureOps (must be /re/agentic).
# If VITE_API_URL is ever set to /re/mesh by mistake, agentic still works as long as VITE_AGENTIC_API_URL is correct.

VITE_AGENTIC_API_URL=/re/agentic
VITE_API_URL=/re/agentic
VITE_DATA_MESH_API_URL=/re/mesh
VITE_DATA_FABRIC_API_URL=/re/fabric
VITE_DATA_ARCH_API_URL=/re/arch
