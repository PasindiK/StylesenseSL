# Same-origin proxy paths (HTTPS) — use with frontend/vercel.json rewrites.
# Set these in Vercel → Settings → Environment Variables for Production, then Redeploy.
# This avoids "Mixed Content" (HTTPS page cannot call http:// Azure IPs directly).
#
# When Azure IPs change, update frontend/vercel.json rewrites and redeploy.

VITE_API_URL=/re/agentic
VITE_AGENTIC_API_URL=/re/agentic
VITE_DATA_MESH_API_URL=/re/mesh
VITE_DATA_FABRIC_API_URL=/re/fabric
VITE_DATA_ARCH_API_URL=/re/arch
