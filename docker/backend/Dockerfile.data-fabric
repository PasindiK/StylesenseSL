# Data Fabric FastAPI service (heavy deps; expect long builds).
# Uses Python 3.10 to match service requirements.
# Build from repository root:
#   docker build -f docker/backend/Dockerfile.data-fabric .
#
# Optional: set DATABASE_URL for Postgres-backed features.

FROM python:3.10-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/src/services/data_fabric/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/src/services/data_fabric/ ./

ENV PYTHONUNBUFFERED=1
ENV PORT=8002
EXPOSE 8002

HEALTHCHECK --interval=30s --timeout=10s --start-period=240s --retries=5 \
    CMD sh -c 'curl -sf "http://127.0.0.1:${PORT:-8002}/api/health/ping" || exit 1'

CMD ["sh", "-c", "exec python -m uvicorn src.api.main:app --host 0.0.0.0 --port ${PORT:-8002}"]
