# Data Architecture lakehouse dashboard API.
# Build from repository root:
#   docker build -f docker/backend/Dockerfile.data-architecture .

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/src/services/data_architecture/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/src/services/data_architecture/ ./

WORKDIR /app/api_server

ENV PYTHONUNBUFFERED=1
ENV PORT=8003
EXPOSE 8003

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD sh -c 'curl -sf "http://127.0.0.1:${PORT:-8003}/api/health" || exit 1'

CMD ["sh", "-c", "exec python -m uvicorn main:app --host 0.0.0.0 --port ${PORT:-8003}"]
