# Stylesense agentic API — single backend image (FastAPI on PORT, default 8000).
# Build from repository root:
#   docker build --platform linux/amd64 -f docker/Dockerfile.backend -t YOUR_USER/stylesense-backend:latest .

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# CPU-only torch first — default pip resolution often pulls multi‑GB CUDA/NVIDIA wheels.
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir torch --index-url https://download.pytorch.org/whl/cpu

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && \
    pip install --no-cache-dir --force-reinstall \
        torch --index-url https://download.pytorch.org/whl/cpu

COPY backend/src/ ./src/
COPY backend/data/ ./data/

ENV PYTHONUNBUFFERED=1
ENV PORT=8000
EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD sh -c 'curl -sf "http://127.0.0.1:${PORT:-8000}/api/health" || exit 1'

CMD ["sh", "-c", "exec python -m uvicorn src.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
