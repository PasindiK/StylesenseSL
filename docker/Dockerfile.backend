# Agentic backend — build context must be repo root (empty Root Directory on Render).
# Dockerfile path field: docker/Dockerfile.backend

FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY backend/src/ src/
COPY backend/data/ data/

ENV PYTHONUNBUFFERED=1
ENV PORT=8000
EXPOSE 8000

# Render injects PORT; local default 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=120s --retries=3 \
    CMD sh -c 'curl -sf "http://127.0.0.1:${PORT:-8000}/api/health" || exit 1'

CMD ["sh", "-c", "exec python -m uvicorn src.api.app:app --host 0.0.0.0 --port ${PORT:-8000}"]
