# Production UI: build Vite app (relative /api) + nginx reverse proxy to backend.
# Build from repo root:
#   docker build -f docker/Dockerfile.web -t YOUR_USER/stylesense-web:latest .

FROM node:20-alpine AS builder
WORKDIR /app
COPY frontend/package*.json ./
RUN npm ci
COPY frontend/ ./
# Empty/unset → app falls back to same-origin /api (works behind this nginx)
ENV VITE_API_URL=
RUN npm run build

FROM nginx:alpine
RUN rm /etc/nginx/conf.d/default.conf
COPY docker/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=5s --start-period=5s --retries=3 \
    CMD wget -qO- http://127.0.0.1/ >/dev/null 2>&1 || exit 1
CMD ["nginx", "-g", "daemon off;"]
