# PostgreSQL Configuration (Shared Service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=fashion_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration (Shared Service)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Fashion Assistant Backend
FASHION_ASSISTANT_PORT=8000
FASHION_ASSISTANT_DEBUG=true
FASHION_ASSISTANT_API_URL=http://fashion-assistant-backend:8000

# Fashion Assistant Frontend
FASHION_ASSISTANT_FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Data Mesh Service
DATA_MESH_PORT=8001
DATA_MESH_API_URL=http://data-mesh:8001

# Data Fabric Service
DATA_FABRIC_PORT=8002
DATA_FABRIC_API_URL=http://data-fabric:8002

# Data Architecture Service
DATA_ARCHITECTURE_PORT=8003
DATA_ARCHITECTURE_API_URL=http://data-architecture:8003

# Nginx Reverse Proxy
NGINX_PORT=80
NGINX_SSL_PORT=443

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# Security Configuration
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost
JWT_SECRET=your_jwt_secret_key_change_this
