# PostgreSQL Configuration (Shared Service)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_password
POSTGRES_DB=fashion_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Redis Configuration (Shared Service)
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Agentic AI Backend
AGENTIC_AI_PORT=8000
AGENTIC_AI_DEBUG=true
AGENTIC_AI_API_URL=http://agentic-ai-backend:8000

# Agentic AI Frontend
AGENTIC_AI_FRONTEND_PORT=3000
VITE_API_URL=http://localhost:8000

# Data Mesh Service
DATA_MESH_PORT=8001
DATA_MESH_API_URL=http://data-mesh:8001

# Data Fabric Service
DATA_FABRIC_PORT=8002
DATA_FABRIC_API_URL=http://data-fabric:8002

# Data Architecture Service
DATA_ARCHITECTURE_PORT=8003
DATA_ARCHITECTURE_API_URL=http://data-architecture:8003

# Nginx Reverse Proxy
NGINX_PORT=80
NGINX_SSL_PORT=443

# Logging Configuration
LOG_LEVEL=INFO
LOG_FORMAT=json

# LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MOCK=1
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
PYTHONUNBUFFERED=1

# Knowledge Graph / Neo4j
KG_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DB=neo4j
KG_BOOTSTRAP_ON_START=false

# Security Configuration
ENABLE_CORS=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost
JWT_SECRET=your_jwt_secret_key_change_this
