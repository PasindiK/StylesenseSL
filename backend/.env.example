# Backend Configuration
PYTHONUNBUFFERED=1
FASTAPI_ENV=development
DATABASE_URL=postgresql://postgres:password@postgres:5432/fashion_db
REDIS_URL=redis://redis:6379/0

# LLM Provider Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MOCK=1
GROQ_API_KEY=your_groq_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Model Configuration
MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DIM=384
VOCAB_BOOST_ENABLED=true
CACHE_SIZE=1000
BATCH_SIZE=32

# API Configuration
API_PORT=8000
API_HOST=0.0.0.0
DEBUG=true
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost

# Frontend Configuration
VITE_API_URL=http://localhost:8000

# Services Configuration
DATA_MESH_URL=http://data-mesh:8001
DATA_FABRIC_URL=http://data-fabric:8002
DATA_ARCHITECTURE_URL=http://data-architecture:8003

# Knowledge Graph / Neo4j
KG_ENABLED=false
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j_password
NEO4J_DB=neo4j
KG_BOOTSTRAP_ON_START=false

# Security
JWT_SECRET=your_jwt_secret_key_change_this
